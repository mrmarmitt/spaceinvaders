// Degrau 1 da PoC sprites: pixel shader do quad — devolve a cor interpolada
// dos vertices. A textura entra no degrau 2.

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float4, Color, COLOR);
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(VSOutput In)
{
    INIT_MAIN;
    RETURN(In.Color);
}
