// Degrau 1 da PoC sprites: o primeiro shader proprio do projeto.
//
// O quad chega com a posicao JA em NDC — a projecao ortografica (pixels ->
// NDC) e aplicada na CPU ao preencher o vertex buffer, o mesmo desenho que o
// batcher do degrau 3 fara por quadro (como o fontstash do The-Forge faz).
// Por isso o shader nao tem recursos (sem cbuffer/textura): passthrough de
// posicao + cor por vertice.

STRUCT(VSInput)
{
    DATA(float2, Position, POSITION);
    DATA(float4, Color, TEXCOORD0);
};

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float4, Color, COLOR);
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN(VSInput In)
{
    INIT_MAIN;
    VSOutput Out;
    Out.Position = float4(In.Position, 0.0f, 1.0f);
    Out.Color = In.Color;
    RETURN(Out);
}
