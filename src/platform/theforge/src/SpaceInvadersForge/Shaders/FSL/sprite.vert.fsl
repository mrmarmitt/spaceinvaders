// Degrau 2 da PoC sprites: vertex shader do quad texturizado. Igual ao
// quad.vert.fsl (posicao ja em NDC, projecao na CPU), mas carregando UV em
// vez de cor - a cor agora vem da textura, no pixel shader.

#include "sprite.srt.h"

STRUCT(VSInput)
{
    DATA(float2, Position, POSITION);
    DATA(float2, UV, TEXCOORD0);
};

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, UV, TEXCOORD0);
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN(VSInput In)
{
    INIT_MAIN;
    VSOutput Out;
    Out.Position = float4(In.Position, 0.0f, 1.0f);
    Out.UV = In.UV;
    RETURN(Out);
}
